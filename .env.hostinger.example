# Production .env for Hostinger. Copy to .env on the server. Never commit the real file.
# After editing: php artisan config:clear && php artisan config:cache

APP_NAME="VFRB Enterprise"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.your-domain.com
APP_RELEASE=                  # git short SHA of this deploy, shown by GET /api/version
APP_DEPLOY_ID=

FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://www.your-domain.com   # optional extras, comma-separated

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger MySQL (hPanel > Databases). Host is usually localhost.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
# No queued jobs exist in the app, so no worker is needed.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Cloudinary: the app uses it for uploads whenever CLOUDINARY_CLOUD_NAME is set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# Gemini: keys from the Google AI Studio project that has billing + a spend cap. key_2/key_3 are optional fallbacks.
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_MODEL=gemini-3.6-flash

# Google sign-in (only if enabled). The redirect URI must also be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback

# Outgoing mail: use the SMTP details from the Hostinger mailbox.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
