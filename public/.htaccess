# SPA hosting for Apache / LiteSpeed (Hostinger). Copied into dist/ by Vite.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Vite content-hashes everything under /assets/, so only those files may be cached forever.
  RewriteRule ^assets/ - [E=VFRB_HASHED:1,L]
  # Missing hashed assets must 404, not fall back to index.html (that causes the stale-chunk MIME error).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  # Unhashed static files (models, icons, logos): revalidate daily so replacing a file under the same name works.
  <FilesMatch "\.(glb|png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header set Cache-Control "public, max-age=31536000, immutable" env=VFRB_HASHED
  # Entry point, service worker and manifest must always be revalidated or autoUpdate cannot work.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
